# ====================================================================
# PORTFOLIO BACKEND ENVIRONMENT CONFIGURATION (.env)
# ====================================================================
# IMPORTANT:
# 1. Copy this file to a new file named `.env` in the /server folder
# 2. Replace the placeholder values below with your real credentials
# 3. NEVER commit the `.env` file to GitHub or any public repository!
# ====================================================================

# Port for local Express server (defaults to 5000 if omitted)
PORT=5000

# Your Gmail address used to authenticate and send the notification email
EMAIL_USER=your-email@gmail.com

# 16-character Gmail App Password (NOT your normal Gmail password)
# Generated from: https://myaccount.google.com/apppasswords
# (Format: 16 lowercase characters without spaces, e.g. abcdfeghijklmnop)
EMAIL_APP_PASSWORD=your-16-char-app-password

# Recipient email address where you want to receive visitor messages
# (Can be the same as EMAIL_USER or a different email)
TO_EMAIL=your-email@gmail.com

# Allowed frontend origins for CORS (comma-separated or single URL)
# For local development with VS Code Live Server / static server + production Vercel site:
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,https://robert-asamoah.vercel.app
